# LifeLink AI — Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave empty to use built-in smart mock data store, or provide your MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/lifelink_ai

# JWT Secret for authentication tokens
JWT_SECRET=lifelink_ai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Optional AI API Key (Gemini or OpenAI) for advanced generative triage notes (heuristics used if not set)
GEMINI_API_KEY=
